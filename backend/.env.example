# Blood Donation Application - Environment Variables Example
# Copy this file to .env and fill in your values

# =======================
# Database Configuration
# =======================
DB_URL=jdbc:mysql://localhost:3306/blood_donate?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# =======================
# JWT Configuration
# =======================
JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long
JWT_EXPIRATION=86400000

# =======================
# CORS Configuration
# =======================
CORS_ALLOWED_ORIGINS=http://localhost:4200

# =======================
# Email Configuration (Brevo SMTP)
# =======================
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=af5dbf001@smtp-brevo.com
MAIL_PASSWORD=your_brevo_smtp_key

# =======================
# Server Configuration
# =======================
SERVER_PORT=8081

# =======================
# Production Settings
# =======================
SPRING_PROFILES_ACTIVE=default
SHOW_SQL=false